# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem
Thumbs.db

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env
.env*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# IDE / editor
.idea/
*.swp

# turbo
.turbo

# spec-kit toolkit — machine-local / per-session state only.
# specs/ is intentionally NOT ignored: the specifications are the project's
# own deliverable and belong in history (unlike the ai-tools template, which
# ships only the engine).
.claude/settings.local.json
.specify/feature.json

.vercel
.env*
!.env.example

.env*

# Rust build output
/target

# Balancer output — machine-local run artifacts. The directory's README.md IS tracked (it documents
# what the reports are), so ignore the generated reports rather than the whole directory.
/balance-reports/*
!/balance-reports/README.md

# Editor workspace file (per-machine paths)
/warformcommander.code-workspace

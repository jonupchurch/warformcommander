{
  "name": "warformcommander",
  "version": "0.1.0",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "lint:tokens": "node scripts/check-no-raw-hex.mjs",
    "typecheck": "tsc --noEmit",
    "test:e2e": "playwright test",
    "test": "dotenv -e .env.dev.local -- vitest run",
    "test:watch": "dotenv -e .env.dev.local -- vitest",
    "db:generate": "dotenv -e .env.local -- drizzle-kit generate",
    "db:push": "dotenv -e .env.local -- drizzle-kit push",
    "db:studio": "dotenv -e .env.local -- drizzle-kit studio",
    "db:migrate": "dotenv -e .env.local -- drizzle-kit migrate",
    "db:migrate:dev": "dotenv -e .env.dev.local -- drizzle-kit migrate",
    "db:push:dev": "dotenv -e .env.dev.local -- drizzle-kit push",
    "db:studio:dev": "dotenv -e .env.dev.local -- drizzle-kit studio"
  },
  "dependencies": {
    "@auth/drizzle-adapter": "^1.11.2",
    "@radix-ui/react-slot": "^1.3.0",
    "@sentry/nextjs": "^10.66.0",
    "@vercel/analytics": "^2.0.1",
    "@wfc/engine-wasm": "*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "lucide-react": "^1.25.0",
    "next": "16.2.10",
    "next-auth": "^5.0.0-beta.31",
    "postgres": "^3.4.9",
    "radix-ui": "^1.6.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv-cli": "^11.0.0",
    "drizzle-kit": "^0.31.10",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}

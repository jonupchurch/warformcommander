# Copy to .env.local and fill in. Values also belong in the Vercel project's
# Environment Variables (Production + Preview). Real .env* files are gitignored.

# --- Sentry ---------------------------------------------------------------
# Public DSN for the Sentry project. Used by both client and server SDK init.
# Safe to expose (it only allows sending events to your project).
NEXT_PUBLIC_SENTRY_DSN=

# Used at BUILD time by withSentryConfig for source-map upload + releases.
# Optional locally; set in CI/Vercel. Without SENTRY_AUTH_TOKEN, upload is skipped.
SENTRY_ORG=
SENTRY_PROJECT=
SENTRY_AUTH_TOKEN=

# --- Database (Neon Postgres) --------------------------------------------
# Postgres connection string, read by Drizzle (db/index.ts, drizzle.config.ts).
# Provision by connecting a Neon database to the Vercel project (Storage → Neon),
# then `vercel env pull .env.local`. For local dev, point at a local Postgres or a
# Neon DEV BRANCH (never run migrations against the production branch — SC-008).
# Never commit the real value — .env* is gitignored.
DATABASE_URL=

# --- Auth (Auth.js v5 + Google — Feature 7) ------------------------------
# AUTH_SECRET: session/CSRF encryption key. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=
# Google OAuth 2.0 Web client (Google Cloud Console → Credentials).
# Authorized redirect URIs: {origin}/api/auth/callback/google
#   http://localhost:3000/api/auth/callback/google  (dev)
#   https://warformcommander.vercel.app/api/auth/callback/google  (prod)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
# Comma-separated Google emails granted the server-side admin role (FR-003).
ADMIN_ALLOWLIST=
